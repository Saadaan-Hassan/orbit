{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.1.0",
  "identifier": "com.saadaan.orbit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbit",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "width": 380,
        "height": 600,
        "visible": false
      },
      {
        "label": "overlay",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "fullscreen": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "../../backend/dist/orbit-backend"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "localhost",
      "signingIdentity": null,
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMjlDQUM4RDQzN0EwQ0QKUldUTm9EZlV5TW9wSUpkU3ErcTdLNzhaa3h3SWhLaTVBUkFEVGJVTUxUK01XZm5qc2ozZVRQekUK",
      "endpoints": [
        "https://github.com/saadaanhassan/orbit/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}

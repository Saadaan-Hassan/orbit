# Cloudflare Worker proxy — all AI API calls route through this
WORKER_URL=https://your-worker.workers.dev

# Local SQLite database path
ORBIT_DB_PATH=~/.orbit/orbit.db

# Uvicorn port
PORT=47821

# Sentry crash reporting (optional — skip to disable)
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
APP_ENVIRONMENT=beta
APP_VERSION=0.1.0

# PostHog analytics (optional — skip to disable)
POSTHOG_API_KEY=phc_your_key_here
POSTHOG_HOST=https://us.i.posthog.com

# --- Keys that do NOT belong here ---
# GEMINI_API_KEY    → Cloudflare Worker secret: cd worker && npx wrangler secret put GEMINI_API_KEY
# VOYAGE_AI_API_KEY → Cloudflare Worker secret: cd worker && npx wrangler secret put VOYAGE_AI_API_KEY
# ANTHROPIC_API_KEY → Cloudflare Worker secret: cd worker && npx wrangler secret put ANTHROPIC_API_KEY

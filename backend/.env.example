# Local SQLite database path
ORBIT_DB_PATH=~/.orbit/orbit.db

# Uvicorn port
PORT=47821

APP_ENVIRONMENT=beta
APP_VERSION=0.1.0

# --- Keys that do NOT belong here ---
# No AI provider key belongs in this file, ever — maintainer-owned or
# user-owned. There are no maintainer-owned keys left anywhere in this
# system (COST-002); a user's own Groq/Voyage key lives only in macOS
# Keychain, set via the app's Settings UI.
